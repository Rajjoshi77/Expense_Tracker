// This is your Prisma schema file
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  avatarUrl     String?
  expenses      Expense[]
  incomes       Income[]
  budgets       Budget[]
  subscriptions Subscription[]
  chats         ChatMessage[]
  createdAt     DateTime       @default(now())
}

model Expense {
  id        String   @id @default(uuid())
  name      String
  amount    Float
  category  String
  type      String   @default("Regular")
  date      DateTime
  merchant  String?
  note      String?
  user      String   @default("Me")
  userId    String?
  userRef   User?    @relation(fields: [userId], references: [id])
  embedding String?  // JSON-serialized float array for vector search
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Budget {
  id           String @id @default(uuid())
  category     String
  monthlyLimit Float
  month        String // "2026-07" format
  userId       String?
  userRef      User?    @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([category, month, userId])
}

model Income {
  id          String   @id @default(uuid())
  source      String
  amount      Float
  date        DateTime
  isRecurring Boolean  @default(false)
  note        String?
  userId      String?
  userRef     User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model Subscription {
  id           String  @id @default(uuid())
  name         String
  amount       Float
  billingCycle String  @default("monthly") // monthly, yearly
  category     String  @default("Other")
  isActive     Boolean @default(true)
  startDate    DateTime @default(now())
  note         String?
  userId       String?
  userRef      User?    @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(uuid())
  role      String   // "user" or "assistant"
  content   String
  metadata  String?  // JSON string for extra data (expense refs, etc.)
  userId    String?
  userRef   User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
